/* Cabecera específica para la página de entradas */
.hero-entradas {
    background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.9)), url('../img/gloosito.jpg') center/cover;
    padding: 4rem 1rem;
    border-bottom: 2px solid #ff0044;
}

/* Contenedor de las tarjetas de abonos (Flexbox) */
.tickets-container {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    margin-top: 1.5rem;
}

/* Tarjeta individual */
.ticket-card {
    background-color: #1a1a1a;
    border: 1px solid #333;
    border-radius: 10px;
    padding: 2rem;
    width: 300px;
    text-align: center;
    position: relative;
    transition: all 0.3s ease;
}

.ticket-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 0 20px rgba(255, 0, 68, 0.4);
    border-color: #ff0044;
}

.ticket-card .precio {
    font-size: 3rem;
    font-weight: bold;
    color: #ff0044;
    margin: 1rem 0;
    text-shadow: 0 0 10px rgba(255, 0, 68, 0.5);
}

.ticket-card ul {
    list-style: none;
    text-align: left;
    margin-top: 1.5rem;
    color: #ccc;
}

.ticket-card ul li {
    margin-bottom: 0.8rem;
    border-bottom: 1px solid #333;
    padding-bottom: 0.5rem;
}

/* Destacar la tarjeta VIP */
.ticket-card.vip {
    border: 2px solid #9900ff;
    box-shadow: 0 0 15px rgba(153, 0, 255, 0.2);
}

.ticket-card.vip:hover {
    box-shadow: 0 0 25px rgba(153, 0, 255, 0.5);
    border-color: #9900ff;
}

.ticket-card.vip .precio {
    color: #9900ff;
    text-shadow: 0 0 10px rgba(153, 0, 255, 0.5);
}

.etiqueta-soldout {
    position: absolute;
    top: -15px;
    right: -15px;
    background-color: #ff0044;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: bold;
    font-size: 0.9rem;
    transform: rotate(15deg);
    box-shadow: 0 2px 5px rgba(0,0,0,0.5);
}

/* Mejoras visuales para el formulario */
.formulario-pro {
    background-color: #111;
    padding: 2.5rem;
    border-radius: 10px;
    border: 1px solid #222;
    box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
}

.form-grupo {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
}

.btn-comprar {
    width: 100%;
    margin-top: 1rem;
    font-size: 1.2rem;
    letter-spacing: 1px;
}